<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Version>3.5.58</Version>
		<PackageId>Fast.SqlSugar</PackageId>
		<Description>Fast.NET 框架 SqlSugar 模块库。</Description>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="$(RepositoryRoot)src\Runtime\Fast.Runtime.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="SqlSugarCore" Version="5.1.4.216" />
		<!-- 覆盖 SqlSugarCore 的传递依赖，固定到已修复安全问题的 2.1.x 原生 SQLite 包。 -->
		<PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
		<PackageReference Include="UAParser" Version="3.1.47" />
		<PackageReference Include="Yitter.IdGenerator" Version="1.0.14" />
	</ItemGroup>

</Project>
